#!/bin/bash
#
# gpushed client. Runs inside the gpushed-cli container (started by the
# `gpushed` command on the Mac); talks to the gpushed API.

set -euo pipefail

API="${GPUSHED_API:-https://api.gpushed.smartloop.ai}"
STATE="${GPUSHED_STATE:-/state}"
TOKEN_FILE="$STATE/token"
KEY="$STATE/box_ssh_key"
VERSION="$(cat /etc/gpushed-version 2>/dev/null || echo dev)"
SSH_OPTS=(-i "$KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ServerAliveInterval=30)

say() { printf '%s\n' "$*"; }
die() { printf '❌ %s\n' "$*" >&2; exit 1; }

# Ask the Mac to open a URL in the browser (the `gpushed` wrapper watches for
# this file); also print it in case that isn't possible.
open_url() {
  printf '%s\n' "$1" > "$STATE/.open-url"
  say "   $1"
}

token() {
  [ -s "$TOKEN_FILE" ] || die "Not signed in. Run: gpushed login"
  cat "$TOKEN_FILE"
}

# api METHOD PATH [JSON]: sets API_STATUS and API_BODY. Exits with the API's
# error message on a 4xx/5xx unless API_ALLOW lists that status. (Call it
# directly, not in $(...), so the globals reach the caller.)
api() {
  local method=$1 path=$2 data=${3:-} out auth=()
  [ "${NO_AUTH:-0}" = 1 ] || auth=(-H "authorization: Bearer $(token)")
  out=$(mktemp)
  API_STATUS=$(curl -sS -o "$out" -w '%{http_code}' -X "$method" "$API$path" \
    -H "content-type: application/json" -H "user-agent: gpushed-cli/$VERSION" "${auth[@]}" \
    ${data:+--data "$data"}) || { rm -f "$out"; die "Could not reach $API"; }
  API_BODY=$(cat "$out"); rm -f "$out"
  if [ "$API_STATUS" -ge 400 ] && [[ " ${API_ALLOW:-} " != *" $API_STATUS "* ]]; then
    local msg; msg=$(jq -r '.error // empty' <<<"$API_BODY" 2>/dev/null || true)
    die "${msg:-request failed (HTTP $API_STATUS)}"
  fi
}

ensure_key() {
  if [ ! -f "$KEY" ]; then
    ssh-keygen -q -t ed25519 -N "" -C "gpushed" -f "$KEY"
    say "🔑 Created an SSH key for your box: ~/.gpushed/state/box_ssh_key"
  fi
}

box_json() { API_ALLOW="404" api GET /v1/box; }  # -> API_STATUS, API_BODY

require_running_box() {
  local b; box_json; b=$API_BODY
  [ "$API_STATUS" != 404 ] || die "You have no box. Create one with: gpushed up"
  BOX_STATUS=$(jq -r .box.status <<<"$b")
  BOX_IP=$(jq -r '.box.ip // empty' <<<"$b")
  BOX_USER=$(jq -r .box.ssh_user <<<"$b")
  [ "$BOX_STATUS" = running ] && [ -n "$BOX_IP" ] || die "Your box is $BOX_STATUS, not running."
}

# Poll the box until it reaches one of the given statuses (or failed).
wait_for() {
  local want=" $* " last="" b status started=$SECONDS
  while true; do
    box_json; b=$API_BODY
    if [ "$API_STATUS" = 404 ]; then status=destroyed; else status=$(jq -r .box.status <<<"$b"); fi
    if [ "$status" != "$last" ]; then
      say "   … $status"
      last=$status
    fi
    [[ $want == *" $status "* ]] && return 0
    if [ "$status" = failed ]; then
      die "$(jq -r '.box.error // "provisioning failed"' <<<"$b")"
    fi
    [ $((SECONDS - started)) -lt 1800 ] || die "Timed out waiting; check later with: gpushed status"
    sleep 5
  done
}

wait_for_ssh() {
  for _ in $(seq 1 60); do
    ssh "${SSH_OPTS[@]}" -o ConnectTimeout=5 "$BOX_USER@$BOX_IP" true 2>/dev/null && return 0
    sleep 5
  done
  die "The box is running but SSH isn't answering yet. Try: gpushed ssh"
}

# Stream the NVIDIA/CUDA setup log until it finishes (it runs on first boot).
follow_setup() {
  if ssh "${SSH_OPTS[@]}" "$BOX_USER@$BOX_IP" test -f /var/log/provisioning-completed; then
    return 0
  fi
  say ""
  say "📦 Installing the NVIDIA driver and CUDA (10-15 minutes on first boot). Ctrl-C stops watching; setup carries on."
  say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  ssh "${SSH_OPTS[@]}" "$BOX_USER@$BOX_IP" \
    'sudo bash -c "while [ ! -f /var/log/provisioning-completed ]; do sleep 5; done" & w=$!; sudo tail -n +1 -F --pid=$w /var/log/setup-script.log 2>/dev/null' || true
  say "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

show_account() {
  local me; api GET /v1/me; me=$API_BODY
  say "👤 $(jq -r .email <<<"$me")"
  say "💰 Balance: \$$(jq -r .balance_usd <<<"$me")"
  if [ "$(jq -r .balance_micros <<<"$me")" -le 0 ]; then
    say "No credit yet. Add some (minimum \$$(jq -r .min_topup_usd <<<"$me")) with: gpushed topup"
  elif [ "$(jq -r .low_balance <<<"$me")" = true ]; then
    say "⚠️  Your balance is low. Boxes stop when it runs out. Top up with: gpushed topup"
  fi
}

usage() {
  cat <<EOF
gpushed $VERSION: GPU boxes on demand, billed from a prepaid balance.

Account
  login [email]   Sign in with a link sent to your email
  logout          Sign out on this Mac
  balance         Show your balance (alias: me)
  topup [usd]     Add credit with Stripe (minimum \$10)
  history         Recent charges and top-ups

Box
  plans           GPUs you can run and their hourly price
  up [plan]       Create your box (default plan: l4) and set it up
  status          Show your box
  ssh [cmd...]    SSH into your box (or run a command on it)
  stop            Stop the box; only its disk is billed while stopped
  start           Start a stopped box
  down            Delete the box and its disk

  version         Show the version
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  login)
    email="${1:-}"
    if [ -z "$email" ]; then
      [ -t 0 ] || die "Usage: gpushed login EMAIL"
      read -r -p "Email: " email
    fi
    NO_AUTH=1 api POST /v1/auth/start "$(jq -nc --arg e "$email" '{email:$e}')"; res=$API_BODY
    rid=$(jq -r .request_id <<<"$res"); pt=$(jq -r .poll_token <<<"$res")
    say "📧 We sent a sign-in link to $email. Open it to continue (waiting up to 15 minutes)..."
    for _ in $(seq 1 300); do
      sleep 3
      NO_AUTH=1 API_ALLOW="202" api POST /v1/auth/poll "$(jq -nc --arg r "$rid" --arg p "$pt" '{request_id:$r, poll_token:$p}')"
      res=$API_BODY
      if [ "$API_STATUS" = 200 ]; then
        umask 077
        jq -r .token <<<"$res" > "$TOKEN_FILE"
        say "✅ Signed in as $(jq -r .account.email <<<"$res")."
        say "💰 Balance: \$$(jq -r .account.balance_usd <<<"$res")"
        if [ "$(jq -r .account.balance_micros <<<"$res")" -le 0 ]; then
          say ""
          say "Add credit to start a box (minimum \$$(jq -r .account.min_topup_usd <<<"$res")): gpushed topup"
        else
          say "Next: gpushed up"
        fi
        exit 0
      fi
    done
    die "Sign-in timed out. Run gpushed login again."
    ;;

  logout)
    if [ -s "$TOKEN_FILE" ]; then API_ALLOW="401" api POST /v1/auth/logout; fi
    rm -f "$TOKEN_FILE"
    say "Signed out."
    ;;

  balance|me)
    show_account
    ;;

  topup)
    amount="${1:-10}"
    [[ $amount =~ ^[0-9]+(\.[0-9]{1,2})?$ ]] || die "Usage: gpushed topup [amount in USD, e.g. 25]"
    api POST /v1/topup "{\"amount_usd\": $amount}"; url=$(jq -r .url <<<"$API_BODY")
    say "💳 Opening Stripe checkout for \$$amount:"
    open_url "$url"
    say "Your balance updates as soon as the payment goes through: gpushed balance"
    ;;

  history)
    api GET /v1/ledger
    jq -r '.entries[] | "\(.created_at | todate)  \(.kind | ascii_upcase | .[0:6])  \(.amount_usd)"' \
      <<<"$API_BODY" | awk '{printf "%-22s %-7s %10s\n", $1, $2, "$"$3}'
    ;;

  plans)
    NO_AUTH=1 api GET /v1/plans
    jq -r '"Region: \(.region)   (default plan: \(.default))\n", (.plans[] | "  \(.id | . + "        " | .[0:8])  $\(.hourly_usd)/h   \(.label)")' <<<"$API_BODY"
    say ""
    say "Prices include disk and IP. A stopped box costs only its disk (about \$0.03/h)."
    ;;

  up)
    plan="${1:-}"
    ensure_key
    body=$(jq -nc --arg p "$plan" --arg k "$(cat "$KEY.pub")" '{ssh_public_key:$k} + (if $p != "" then {plan:$p} else {} end)')
    api POST /v1/box "$body"; res=$API_BODY
    say "🚀 Creating box $(jq -r .box.id <<<"$res") ($(jq -r .box.plan <<<"$res"), \$$(jq -r .box.hourly_usd <<<"$res")/h, billed per second while it exists)"
    wait_for running
    require_running_box
    say "✅ Running at $BOX_IP"
    wait_for_ssh
    follow_setup
    say ""
    say "🎉 Your GPU box is ready."
    say "   gpushed ssh      # connect, then try: nvidia-smi"
    say "   gpushed stop     # pause it (disk kept, ~\$0.03/h)"
    say "   gpushed down     # delete it"
    ;;

  status)
    box_json; b=$API_BODY
    if [ "$API_STATUS" = 404 ]; then
      say "No box. Create one with: gpushed up"
    else
      jq -r '.box | "📦 Box \(.id)\n   Plan:    \(.plan)  ($\(.hourly_usd)/h running, $\(.stopped_hourly_usd)/h stopped)\n   Status:  \(.status)\n   Zone:    \(.zone // "-")\n   IP:      \(.ip // "-")" + (if .error then "\n   Error:   \(.error)" else "" end)' <<<"$b"
      say "💰 Balance: \$$(jq -r .account.balance_usd <<<"$b")"
      [ "$(jq -r .account.low_balance <<<"$b")" = true ] && say "⚠️  Balance is low; the box stops when it runs out. gpushed topup"
    fi
    ;;

  ssh)
    require_running_box
    [ -f "$KEY" ] || die "This Mac doesn't have the key for your box (~/.gpushed/state/box_ssh_key)."
    exec ssh "${SSH_OPTS[@]}" -t "$BOX_USER@$BOX_IP" "$@"
    ;;

  stop)
    api POST /v1/box/stop
    say "⏸️  Stopping your box..."
    wait_for stopped
    say "✅ Stopped. Start it again with: gpushed start"
    ;;

  start)
    api POST /v1/box/start
    say "▶️  Starting your box..."
    wait_for running
    require_running_box
    say "✅ Running at $BOX_IP. Connect with: gpushed ssh"
    ;;

  down)
    if [ -t 0 ]; then
      read -r -p "Delete your box and everything on its disk? (y/N) " reply
      [[ $reply =~ ^[Yy]$ ]] || { say "Cancelled."; exit 0; }
    fi
    api DELETE /v1/box
    say "🗑️  Deleting your box..."
    wait_for destroyed
    say "✅ Deleted. You're no longer billed for it."
    ;;

  version|--version|-v)
    say "$VERSION"
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    usage
    exit 1
    ;;
esac

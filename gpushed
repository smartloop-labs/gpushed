#!/bin/bash
#
# gpushed: GPU boxes on demand, from your terminal.
#
# This wrapper runs the gpushed client (client/gpushed-cli) on this machine's
# own bash, curl, jq and ssh: no containers, no Terraform, no gcloud, no
# cloud account. The client holds no cloud credentials; your API token and
# SSH key live in ~/.gpushed/state. Runs on macOS and Linux.

set -euo pipefail

INSTALLER_URL="${GPUSHED_INSTALLER_URL:-https://gpushed.dev/install.sh}"

# Find the install directory, following symlinks (~/.local/bin/gpushed -> ~/.gpushed/gpushed).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$LINK_DIR/$SOURCE"
done
BOX_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
STATE="$BOX_DIR/state"
CLI="$BOX_DIR/client/gpushed-cli"

if [ -f "$BOX_DIR/VERSION" ]; then
  VERSION="$(cat "$BOX_DIR/VERSION")"
else
  VERSION="dev" # a git checkout
fi

say() { printf '%s\n' "$*"; }
die() { printf '❌ %s\n' "$*" >&2; exit 1; }

# How to install a missing command on this system.
install_hint() {
  if [ "$(uname -s)" = Darwin ]; then
    command -v brew >/dev/null 2>&1 && { echo "brew install $1"; return; }
    echo "install it (e.g. with Homebrew: brew install $1)"
  elif command -v apt-get >/dev/null 2>&1; then echo "sudo apt-get install $2"
  elif command -v dnf >/dev/null 2>&1; then echo "sudo dnf install $2"
  elif command -v pacman >/dev/null 2>&1; then echo "sudo pacman -S $2"
  elif command -v apk >/dev/null 2>&1; then echo "sudo apk add $2"
  else echo "install $2 with your package manager"
  fi
}

# Everything the client calls, checked up front so a missing tool fails
# with a fix instead of halfway through a command.
check_deps() {
  local missing=0 cmd pkg
  for pair in curl:curl jq:jq ssh:openssh-client ssh-keygen:openssh-client; do
    cmd="${pair%%:*}" pkg="${pair#*:}"
    if ! command -v "$cmd" >/dev/null 2>&1; then
      say "❌ gpushed needs $cmd. To get it: $(install_hint "$cmd" "$pkg")" >&2
      missing=1
    fi
  done
  [ "$missing" = 0 ] || exit 1
  [ -f "$CLI" ] || die "The gpushed client is missing ($CLI). Reinstall: curl -fsSL gpushed.dev/install.sh | bash"
}

# Releases up to v0.3.x ran the client in Apple's container runtime; drop
# their client images, which are no longer used. (The runtime itself is left
# installed: other tools may use it. Remove it with Apple's uninstall script.)
remove_old_images() {
  command -v container >/dev/null 2>&1 || return 0
  container image list -q 2>/dev/null | grep '^gpushed-cli' \
    | xargs container image delete >/dev/null 2>&1 || true
}

run_client() {
  mkdir -p "$STATE"
  chmod 700 "$STATE"
  GPUSHED_STATE="$STATE" GPUSHED_VERSION="$VERSION" exec bash "$CLI" "$@"
}

case "${1:-help}" in
  init)
    # First-time setup: check the tools gpushed uses, then sign in.
    check_deps
    remove_old_images
    say "✅ Ready."
    say ""
    if [ -s "$STATE/token" ]; then
      run_client balance
    else
      run_client login "${@:2}"
    fi
    ;;
  version|--version|-v)
    say "$VERSION"
    ;;
  update)
    [ "$VERSION" != dev ] || die "This is a git checkout; update it with: git -C \"$BOX_DIR\" pull"
    say "⬆️  Updating gpushed (currently $VERSION)..."
    curl -fsSL "$INSTALLER_URL" | GPUSHED_HOME="$BOX_DIR" bash
    ;;
  uninstall)
    say "This removes gpushed from this computer. It does not delete a box you have running;"
    say "run 'gpushed down' first if you have one."
    read -r -p "Uninstall? (y/N) " reply
    [[ $reply =~ ^[Yy]$ ]] || exit 0
    remove_old_images
    bin_dir="${GPUSHED_BIN_DIR:-$HOME/.local/bin}"
    rm -f "$bin_dir/gpushed"
    for a in gsh gs; do # gs: the alias up to v0.4.0
      [ -L "$bin_dir/$a" ] && [ "$(readlink "$bin_dir/$a")" = "$BOX_DIR/gpushed" ] && rm -f "$bin_dir/$a"
    done
    rm -rf "$BOX_DIR"
    say "✅ Uninstalled."
    ;;
  *)
    check_deps
    run_client "$@"
    ;;
esac
